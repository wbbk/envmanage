# ============================================================
# EnvManage .gitignore —— 原生 SwiftUI 构建产物与本地环境屏蔽
# ============================================================

# ---------- 构建产物 ----------
# .app / .dmg 交付包
dist/
# 程序化生成的图标二进制（build.sh 由 Scripts/make_icon.swift 重新生成）
Resources/
# swift 中间产物
.build/
build/
DerivedData/
*.dSYM/
*.swiftmodule
*.o

# ---------- 文档（本地维护，不入库） ----------
docs/

# ---------- 本地开发环境 / IDE ----------
.venv/
venv/
__pycache__/
*.py[cod]
# PyCharm 工程配置
.idea/
.vscode/

# ---------- macOS 系统过程文件 ----------
.DS_Store
.DS_Store?
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# ---------- 临时 / 隐藏过程文件 ----------
tmp/
.temp/
*.tmp
*.bak
*.swp
*.log
logs/
